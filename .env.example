# CommerceCore settings: ONE file for every layer (migrations, DAL, services, API).
# Copy this file and fill it in:   cp .env.example .env
# Variables already set in the real environment win over this file.

# --- Database (read by the DAL, the migrations and the tests)
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/commercecore

# Print every SQL statement (handy while learning / debugging): true / false
DB_ECHO=false

# Used ONLY by the tests. Must be a SEPARATE database whose name contains "test":
# the tests empty every table before each test.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/commercecore_test

# --- API login tokens (read by commercecore-api)
# Signs the access tokens. Keep it secret; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login (access token) stays valid, in minutes.
ACCESS_TOKEN_MINUTES=60
