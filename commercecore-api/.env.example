# Copy this file to .env and fill it in:  cp .env.example .env
# (The database connection is configured in ../commercecore-dal/.env)

# Signs the login tokens. Keep it secret; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a login (access token) stays valid, in minutes.
ACCESS_TOKEN_MINUTES=60
