# CommerceCore web settings (copy to .env.local to override)

# Where the browser sends API calls. The default "/api" goes through the Vite dev proxy
# (the API has no CORS headers). In production, point this at a same-origin reverse proxy.
VITE_API_URL=/api

# ISO 4217 currency used to display prices (the API stores plain decimals, no currency).
VITE_CURRENCY=USD

# Dev proxy target: where FastAPI is listening.
API_PROXY_TARGET=http://127.0.0.1:8000
